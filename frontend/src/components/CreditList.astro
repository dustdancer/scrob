---
import { creditSearchText } from "../lib/creditList";
import { crewJobLabel } from "../lib/labels";
import { formatNumber } from "../lib/format";
import { m } from "../paraglide/messages.js";

interface Person {
  tmdb_id?: number | null;
  name: string;
  job?: string | null;
  profile_path?: string | null;
}

// Full, searchable crew list of a title. Hidden until the crew panel's
// "Show full crew" button reveals it (see the script below).
const { people } = Astro.props as { people: Person[] };
const countLabel = (n: number) => m.castcrew_people_count({ count: n, formatted: formatNumber(n) });
---
<div data-credit-list hidden class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <label class="min-w-0 flex-1 text-sm text-zinc-300">
      <span class="sr-only">{m.castcrew_search_label()}</span>
      <input type="search" data-credit-search placeholder={m.castcrew_search_placeholder()} class="w-full max-w-md rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-zinc-100 placeholder:text-zinc-400 focus-visible:outline-2 focus-visible:outline-blue-400" />
    </label>
    <span data-credit-count aria-live="polite" class="text-sm tabular-nums text-zinc-400">{countLabel(people.length)}</span>
    <button type="button" data-credit-back class="rounded-full border border-zinc-600 px-4 py-2 text-sm font-semibold text-zinc-200 hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-blue-400">{m.castcrew_back_to_cards()}</button>
  </div>
  <ul class="max-h-[65vh] overflow-y-auto overscroll-contain divide-y divide-zinc-800 rounded-lg border border-zinc-800" tabindex="0" aria-label={m.castcrew_list_label()}>
    {people.map((person) => {
      const role = person.job ? crewJobLabel(person.job) : "";
      return (
        <li data-credit-row data-search={creditSearchText(person.name, role, person.job)} class="flex items-center gap-4 p-3">
          <div class="h-14 w-11 shrink-0 overflow-hidden rounded bg-zinc-800">
            {person.profile_path ? <img src={person.profile_path} alt="" width="44" height="56" loading="lazy" class="h-full w-full object-cover" /> : <span class="flex h-full items-center justify-center text-zinc-400" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg></span>}
          </div>
          <div class="min-w-0 flex-1 sm:grid sm:grid-cols-2 sm:gap-4">
            {person.tmdb_id ? <a href={`/person/${person.tmdb_id}`} class="break-words font-semibold text-zinc-100 hover:text-blue-400 hover:underline">{person.name}</a> : <span class="break-words font-semibold text-zinc-100">{person.name}</span>}
            <p class="mt-1 break-words text-sm text-zinc-400 sm:mt-0">{role}</p>
          </div>
        </li>
      );
    })}
  </ul>
  <p data-credit-empty hidden class="text-sm text-zinc-400">{m.castcrew_no_matches()}</p>
</div>

<script>
  import { matchesCreditQuery } from "../lib/creditList";
  import { formatNumber } from "../lib/format";

  document.querySelectorAll<HTMLElement>("[data-credit-list]").forEach((list) => {
    const input = list.querySelector<HTMLInputElement>("[data-credit-search]")!;
    const rows = [...list.querySelectorAll<HTMLElement>("[data-credit-row]")];
    const count = list.querySelector<HTMLElement>("[data-credit-count]")!;
    const empty = list.querySelector<HTMLElement>("[data-credit-empty]")!;
    const total = count.textContent;
    const update = () => {
      let shown = 0;
      rows.forEach((row) => {
        const match = matchesCreditQuery(row.dataset.search ?? "", input.value);
        row.hidden = !match;
        if (match) shown++;
      });
      empty.hidden = shown > 0;
      // The count label is a localized plural, so it comes from the server for
      // the total only; while filtering show "<shown> / <total>".
      count.textContent = input.value.trim() ? `${formatNumber(shown)} / ${total}` : total;
    };
    input.addEventListener("input", update);
    // Going back to the cards starts the next visit with an unfiltered list.
    list.querySelector("[data-credit-back]")?.addEventListener("click", () => {
      input.value = "";
      update();
    });
  });
</script>
